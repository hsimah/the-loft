#!/usr/bin/env bash
# lady-grey host bootstrap — sourced by setup.sh (§11b)
# Expects: REPO_DIR, HOST_NAME, host.conf vars, info/warn/error from the caller.
#
# Fedora niri touch dashboard: greetd autologs rodnik into niri with the
# Noctalia shell, a Firefox kiosk on Capcom (Home Assistant) under the bar and
# the Pupshow photo frame when idle. rodnik's desktop (niri, Noctalia, kiosk
# scripts) is blanco's lady-grey overlay; this file owns the system side.
# Runbook: docs/hosts/lady-grey.md

info "Provisioning niri kiosk..."

# ── Packages ──────────────────────────────────────────────────────────────
# Without weak deps: niri otherwise recommends waybar, alacritty, swaylock and
# the GNOME portals, and Noctalia a keyring and power-profiles-daemon. greetd
# pulls in greetd-selinux automatically. kitty and fuzzel match blanco's binds
# (Mod+T, Mod+Space); upower feeds Noctalia's battery widget; stow deploys
# blanco.
info "Installing niri + Noctalia + kiosk packages..."
dnf install -y -q --setopt=install_weak_deps=False \
  niri noctalia greetd swayidle kitty fuzzel firefox upower brightnessctl stow \
  mesa-dri-drivers dejavu-sans-fonts google-noto-color-emoji-fonts > /dev/null
info "Installed $(niri --version), $(rpm -q noctalia)"

# ── linux-surface (touchscreen) ───────────────────────────────────────────
# The Surface Pro 4 touchscreen is Intel IPTS, which the stock kernel does not
# drive: it needs linux-surface's kernel and iptsd (udev starts iptsd@hidrawN).
# The watchdog keeps kernel-surface the default boot entry after Fedora kernel
# updates. Secure Boot is off on this unit; with it on, surface-secureboot and
# a MOK enrolment at the console are also needed. A reboot activates the kernel.
if [[ ! -f /etc/yum.repos.d/linux-surface.repo ]]; then
  dnf config-manager addrepo --from-repofile=https://pkg.surfacelinux.com/fedora/linux-surface.repo
fi
dnf install -y -q --allowerasing kernel-surface iptsd libwacom-surface \
  kernel-surface-default-watchdog > /dev/null
systemctl enable --now linux-surface-default-watchdog.path > /dev/null 2>&1
if [[ "$(uname -r)" != *.surface.* ]]; then
  warn "Running $(uname -r), not kernel-surface: reboot for the touchscreen"
fi

# ── Kiosk session and settings ────────────────────────────────────────────
# blanco's kiosk scripts read /etc/default/loft-kiosk.
install -m 755 "${REPO_DIR}/hosts/${HOST_NAME}/loft-kiosk-session.sh" /usr/local/bin/loft-kiosk-session
cat > /etc/default/loft-kiosk <<KIOSK
# Generated by hosts/${HOST_NAME}/bootstrap from host.conf.
KIOSK_DASHBOARD_URL="${KIOSK_DASHBOARD_URL}"
KIOSK_PHOTO_URL="${KIOSK_PHOTO_URL}"
KIOSK_PHOTO_IDLE="${KIOSK_PHOTO_IDLE:-0}"
KIOSK_SCREEN_OFF_IDLE="${KIOSK_SCREEN_OFF_IDLE:-0}"
KIOSK

install -d -o rodnik -g rodnik /home/rodnik/.config /home/rodnik/.config/niri \
  /home/rodnik/Pictures /home/rodnik/Pictures/Wallpapers
# Noctalia regenerates noctalia.kdl on theme changes; niri refuses to start if
# the include is missing, so seed it empty once.
if [[ ! -e /home/rodnik/.config/niri/noctalia.kdl ]]; then
  install -o rodnik -g rodnik -m 644 /dev/null /home/rodnik/.config/niri/noctalia.kdl
fi
info "Kiosk: ${KIOSK_DASHBOARD_URL}; photo frame after ${KIOSK_PHOTO_IDLE}s idle"

# ── Desktop (blanco) ──────────────────────────────────────────────────────
# adminhabl owns the clone, like /srv/the-loft, and pulls it by hand; rodnik
# only reads it. Setup clones it once with adminhabl's kennl key; if that
# fails, the desktop is skipped until a rerun. blanco's deploy.sh, run as
# rodnik, stows the shared configs and the lady-grey overlay (selected by
# hostname) as links into the clone, so a pull changes existing files at
# once; files added or removed in blanco need a rerun of setup.
BLANCO_URL="ssh://git@kennl.loft.hsimah.com:2222/hsimah/blanco.git"
BLANCO_DIR="/srv/blanco"
# From a directory each user can read: git refuses an unreadable cwd.
as_admin() { (cd /srv && sudo -u adminhabl -H "$@"); }
as_rodnik() { (cd /home/rodnik && sudo -u rodnik -H "$@"); }

if [[ ! -d "${BLANCO_DIR}/.git" ]]; then
  install -d -o adminhabl -g adminhabl "$BLANCO_DIR"
  as_admin env GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10" \
    git clone -q "$BLANCO_URL" "$BLANCO_DIR" \
    && info "Cloned blanco to ${BLANCO_DIR}"
fi

if [[ -d "${BLANCO_DIR}/.git" ]]; then
  # Real files stow would conflict with: copies from the pre-blanco bootstrap,
  # or the default config niri writes when started without one.
  for f in .config/niri/config.kdl .config/noctalia/config.toml \
    .local/share/loft-dashboard-firefox/user.js .local/share/loft-photos-firefox/user.js; do
    if [[ -f "/home/rodnik/${f}" && ! -L "/home/rodnik/${f}" ]]; then
      rm "/home/rodnik/${f}"
    fi
  done
  # Pre-blanco system copies; drop this block once lady-grey has rerun setup.
  rm -f /usr/local/bin/loft-dashboard /usr/local/bin/loft-idle /usr/local/bin/loft-photo-frame
  if [[ -f /etc/systemd/user/noctalia.service ]]; then
    systemctl --global disable noctalia.service > /dev/null 2>&1
    rm /etc/systemd/user/noctalia.service
  fi

  if as_rodnik "${BLANCO_DIR}/scripts/deploy.sh" > /dev/null; then
    info "blanco deployed for rodnik ($(as_admin git -C "$BLANCO_DIR" rev-parse --short HEAD))"
  else
    warn "blanco: deploy.sh skipped conflicting packages; see: sudo -u rodnik -H ${BLANCO_DIR}/scripts/deploy.sh --dry-run"
  fi
  # Enable without rodnik's user manager running (what systemctl --user
  # enable would link). Started with the niri session.
  as_rodnik install -d /home/rodnik/.config/systemd/user/graphical-session.target.wants
  as_rodnik ln -sfn ../noctalia.service \
    /home/rodnik/.config/systemd/user/graphical-session.target.wants/noctalia.service
  if ! niri validate -c /home/rodnik/.config/niri/config.kdl > /dev/null 2>&1; then
    warn "niri rejected /home/rodnik/.config/niri/config.kdl; check: niri validate -c <file>"
  fi
else
  warn "blanco not cloned; check adminhabl can: git clone ${BLANCO_URL}; then rerun setup"
fi
# Files written as root under a home directory can carry the wrong SELinux
# label; reset them to the policy defaults.
command -v restorecon > /dev/null && restorecon -R /home/rodnik

# ── greetd autologin (rodnik → niri) ──────────────────────────────────────
# initial_session runs once per boot (greetd's runfile, /run/greetd.run, records
# it; a plain greetd restart lands on agreety); loft-kiosk-session restarts niri
# itself. Fedora runs greetd on VT1 (it replaces getty@tty1); a text console
# remains on VT2 (Ctrl+Alt+F2).
info "Configuring greetd autologin (rodnik → niri)..."
cat > /etc/greetd/config.toml <<'GREETD'
# Generated by hosts/lady-grey/bootstrap.
[terminal]
vt = 1

[initial_session]
command = "/usr/local/bin/loft-kiosk-session"
user = "rodnik"

[default_session]
command = "agreety --cmd /bin/bash"
user = "greetd"
GREETD
# --force takes over the display-manager.service alias from any other DM.
systemctl enable --force greetd.service 2> /dev/null
systemctl set-default graphical.target > /dev/null 2>&1
info "greetd enabled; reboot to start the kiosk"

# ── Firewall ──────────────────────────────────────────────────────────────
# Fedora enables firewalld. Glances (Houstn) and the Beszel agent (Snoot) use
# host networking, so their ports must be opened; SSH is open by default.
if systemctl is-active -q firewalld; then
  for port in 61208/tcp 45876/tcp; do
    firewall-cmd -q --permanent --add-port="$port"
  done
  firewall-cmd -q --reload
  info "firewalld: opened 61208/tcp (Glances) and 45876/tcp (Beszel agent)"
fi

# ── Always on ─────────────────────────────────────────────────────────────
info "Disabling suspend/sleep/hibernate..."
systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
mkdir -p /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/kiosk.conf <<'LOGIND'
[Login]
IdleAction=ignore
HandleLidSwitch=ignore
HandleLidSwitchExternalPower=ignore
HandleLidSwitchDocked=ignore
LOGIND

info "niri kiosk provisioning complete"
