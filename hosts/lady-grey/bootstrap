#!/usr/bin/env bash
# lady-grey host bootstrap — sourced by setup.sh (§11b)
# Expects: REPO_DIR, HOST_NAME, host.conf vars, info/warn/error from the caller.
#
# Niri touch-dashboard kiosk: greetd autologs rodnik into niri, which runs a
# Firefox kiosk on Capcom (Home Assistant) and the Pupshow photo frame when
# idle. Runbook: docs/hosts/lady-grey.md

NIRI_SRC="${REPO_DIR}/hosts/${HOST_NAME}/niri"
info "Provisioning niri kiosk..."

# ── Packages ──────────────────────────────────────────────────────────────
# Runtime libraries for the container-built niri (EGL and the Mesa drivers are
# loaded at runtime, so ldd does not show them), greetd for autologin,
# swayidle for the idle timeouts and foot as the admin terminal (Mod+Return).
info "Installing niri runtime + kiosk packages..."
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
  libinput10 libseat1 libgbm1 libxkbcommon0 libdisplay-info2 \
  libpangocairo-1.0-0 libegl1 libegl-mesa0 libgles2 libgl1-mesa-dri \
  greetd swayidle foot firefox-esr \
  fonts-dejavu-core fonts-noto-color-emoji > /dev/null

# Purge installer desktop/laptop cruft (shared with Calavera and Woodstock).
source "${REPO_DIR}/control-plane/kiosk-debloat.sh"

# ── niri ──────────────────────────────────────────────────────────────────
# Installed from /var/lib/loft/niri/niri-<tag>.tar.gz, built on space-needle
# (docs/hosts/lady-grey.md#niri). Without it, build here: slow on this CPU.
NIRI_TARBALL="/var/lib/loft/niri/niri-${NIRI_TAG}.tar.gz"
NIRI_STAMP="/usr/local/share/loft/niri-commit"
if [[ "$(cat "$NIRI_STAMP" 2>/dev/null)" != "$NIRI_COMMIT" ]]; then
  if [[ ! -f "$NIRI_TARBALL" ]]; then
    warn "No ${NIRI_TARBALL}; building niri ${NIRI_TAG} on this host (slow)..."
    bash "${NIRI_SRC}/build-niri.sh" /var/lib/loft/niri > /dev/null
  fi
  niri_stage="$(mktemp -d)"
  tar -xzf "$NIRI_TARBALL" -C "$niri_stage"
  install -m 755 "${niri_stage}/niri" "${niri_stage}/niri-session" /usr/local/bin/
  install -d /usr/local/lib/systemd/user /usr/local/share/loft
  install -m 644 "${niri_stage}/niri.service" "${niri_stage}/niri-shutdown.target" \
    /usr/local/lib/systemd/user/
  rm -rf "$niri_stage"
  echo "$NIRI_COMMIT" > "$NIRI_STAMP"
  info "Installed $(/usr/local/bin/niri --version)"
else
  info "niri ${NIRI_TAG} already installed"
fi

# ── Kiosk scripts and settings ────────────────────────────────────────────
for script in loft-dashboard loft-photo-frame loft-idle loft-kiosk-session; do
  install -m 755 "${NIRI_SRC}/${script}.sh" "/usr/local/bin/${script}"
done
cat > /etc/default/loft-kiosk <<KIOSK
# Generated by hosts/${HOST_NAME}/bootstrap from host.conf.
KIOSK_DASHBOARD_URL="${KIOSK_DASHBOARD_URL}"
KIOSK_PHOTO_URL="${KIOSK_PHOTO_URL}"
KIOSK_PHOTO_IDLE="${KIOSK_PHOTO_IDLE:-0}"
KIOSK_SCREEN_OFF_IDLE="${KIOSK_SCREEN_OFF_IDLE:-0}"
KIOSK

install -d -o rodnik -g rodnik /home/rodnik/.config/niri
sed -e "s|@NIRI_OUTPUT@|${NIRI_OUTPUT}|" -e "s|@NIRI_SCALE@|${NIRI_SCALE}|" \
  "${NIRI_SRC}/config.kdl" > /home/rodnik/.config/niri/config.kdl
chown rodnik:rodnik /home/rodnik/.config/niri/config.kdl
if ! /usr/local/bin/niri validate -c /home/rodnik/.config/niri/config.kdl > /dev/null 2>&1; then
  warn "niri rejected /home/rodnik/.config/niri/config.kdl; check: niri validate -c <file>"
fi

for profile in loft-dashboard-firefox loft-photos-firefox; do
  install -d -o rodnik -g rodnik "/home/rodnik/.local/share/${profile}"
  install -o rodnik -g rodnik -m 644 "${NIRI_SRC}/user.js" \
    "/home/rodnik/.local/share/${profile}/user.js"
done
info "Kiosk: ${KIOSK_DASHBOARD_URL}; photo frame after ${KIOSK_PHOTO_IDLE}s idle"

# ── greetd autologin (rodnik → niri) ──────────────────────────────────────
# initial_session runs once per greetd start; loft-kiosk-session restarts niri
# itself. agreety on VT7 is only reached if greetd is restarted by hand.
info "Configuring greetd autologin (rodnik → niri)..."
cat > /etc/greetd/config.toml <<'GREETD'
# Generated by hosts/lady-grey/bootstrap.
[terminal]
vt = 7

[initial_session]
command = "/usr/local/bin/loft-kiosk-session"
user = "rodnik"

[default_session]
command = "/usr/sbin/agreety --cmd /bin/bash"
user = "_greetd"
GREETD
systemctl disable lightdm.service gdm3.service 2>/dev/null || true
# --force takes over the display-manager.service alias from any other DM.
systemctl enable --force greetd.service 2>/dev/null
systemctl set-default graphical.target > /dev/null
info "greetd enabled; reboot to start the kiosk"

# ── Always on ─────────────────────────────────────────────────────────────
info "Disabling suspend/sleep/hibernate..."
systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
mkdir -p /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/kiosk.conf <<'LOGIND'
[Login]
IdleAction=ignore
HandleLidSwitch=ignore
HandleLidSwitchExternalPower=ignore
HandleLidSwitchDocked=ignore
LOGIND

info "niri kiosk provisioning complete"
