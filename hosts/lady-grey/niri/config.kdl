// rodnik's niri config on Lady Grey. The bootstrap fills @NIRI_OUTPUT@ and
// @NIRI_SCALE@ from host.conf and installs it to ~rodnik/.config/niri/;
// niri reloads it on change. Reference: https://github.com/niri-wm/niri/wiki

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
    }
}

output "@NIRI_OUTPUT@" {
    scale @NIRI_SCALE@
    transform "normal"
}

layout {
    gaps 0
    default-column-width { proportion 1.0; }
    focus-ring {
        off
    }
    border {
        off
    }
}

prefer-no-csd
screenshot-path null

hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 2000
}

// Single-purpose display: every window (dashboard, photo frame, the admin
// terminal) opens fullscreen. The newest window covers the others, so the
// photo frame sits over the dashboard until loft-photo-frame closes it.
window-rule {
    open-fullscreen true
}

spawn-at-startup "/usr/local/bin/loft-dashboard"
spawn-at-startup "/usr/local/bin/loft-idle"

// Admin bindings for the Type Cover. Day-to-day administration is over SSH.
binds {
    Mod+Return { spawn "foot"; }
    Mod+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Shift+E { quit; }
}
