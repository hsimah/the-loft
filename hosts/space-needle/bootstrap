# hosts/space-needle/bootstrap — sourced by setup.sh after services start.
# Shares REPO_DIR and the info/warn helpers.

# Paperless and paperless-gpt reach llama-swap on helarctos through the
# `mercurius-llm` bridge, and nothing else. The table is ours alone; the
# distro nftables service stays disabled, because its config flushes Docker's
# rules.
#   docs/services/mercurius.md#model-egress
info "Installing the Mercurius model egress firewall..."

DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nftables > /dev/null
install -d -m 755 /etc/loft
install -m 644 "${REPO_DIR}/hosts/space-needle/mercurius-egress.nft" /etc/loft/mercurius-egress.nft
install -m 644 "${REPO_DIR}/hosts/space-needle/loft-mercurius-egress.service" /etc/systemd/system/
systemctl daemon-reload
if nft --check --file /etc/loft/mercurius-egress.nft; then
  systemctl enable loft-mercurius-egress > /dev/null 2>&1
  systemctl restart loft-mercurius-egress || warn "loft-mercurius-egress failed; check: sudo journalctl -u loft-mercurius-egress"
else
  warn "mercurius-egress.nft does not parse; do not enable the ocr profile"
fi
