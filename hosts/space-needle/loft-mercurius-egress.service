[Unit]
Description=Loft Mercurius model egress firewall
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target docker.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/loft/mercurius-egress.nft
ExecReload=/usr/sbin/nft -f /etc/loft/mercurius-egress.nft

[Install]
WantedBy=multi-user.target
