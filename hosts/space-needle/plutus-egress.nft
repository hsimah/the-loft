# Plutus model egress on space-needle. Installed to /etc/loft/ by the bootstrap
# and loaded by loft-plutus-egress.service.
#
# Covers only the `plutus-llm` bridge, which the `gpt` container (paperless-gpt)
# and later Paperless join. They may reach llama-swap on helarctos and nothing
# else: no DNS, no other LAN host, no Tailscale, no internet, no IPv6, and
# nothing on this host. Plutus's other networks are Docker `internal` and have
# no route at all.
# Runs after Docker's chains: an accept here cannot override Docker's drops,
# and a drop here is final. Never `flush ruleset` or enable the distro
# nftables service; both would remove Docker's rules.
#   docs/services/plutus.md#model-egress

destroy table inet loft_plutus

table inet loft_plutus {
    chain forward {
        type filter hook forward priority 10; policy accept;

        ct state established,related accept
        # llama-swap on helarctos, by the address Compose pins in extra_hosts.
        iifname "plutus-llm" ip daddr 192.168.86.21 tcp dport 8080 accept
        iifname "plutus-llm" counter drop
    }

    chain input {
        type filter hook input priority 10; policy accept;

        # Replies to the loopback web page; nothing the containers start.
        iifname "plutus-llm" ct state established,related accept
        iifname "plutus-llm" counter drop
    }
}
