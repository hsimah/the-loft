{
    admin 127.0.0.1:8880
    auto_https off
}
# HTTP only on the private origin hop; Cloudflare terminates public TLS.
# Exact Host matching, no generic application or trusted-LAN fallback.
:8080 {
    log
    @hbla_ke host hbla.ke
    handle @hbla_ke {
        reverse_proxy pawst:8080 {
            header_up Host hbla.ke
        }
    }
    @hsimah_com host hsimah.com
    handle @hsimah_com {
        reverse_proxy pawst:8080 {
            header_up Host hsimah.com
        }
    }
    @clog host clog.hsimah.com
    handle @clog {
        reverse_proxy clog:8080 {
            header_up Host clog.hsimah.com
            # Cloudflare supplies this via the isolated connector network.
            # Overwrite any caller-provided application identity header.
            header_up X-Clog-Client-IP {http.request.header.Cf-Connecting-Ip}
        }
    }
    handle {
        respond "Unknown application" 404
    }
}
