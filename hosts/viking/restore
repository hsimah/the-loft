#!/usr/bin/env bash
# Recover each Pawst site's latest release after the operator restores Viking's host boundary.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MODE="${1:---plan}"
fail() { echo "ERROR: $*" >&2; exit 1; }
if [[ "$MODE" == --help ]]; then
  echo "Usage: hosts/viking/restore [--plan|--apply]"
  echo "Default: show content recovery commands without changing anything."
  echo "Apply requires a prepared Viking, tested firewall, and stopped Pawst/tunnel."
  exit 0
fi
[[ $# -le 1 && ( "$MODE" == --plan || "$MODE" == --apply ) ]] || fail "Use --plan or --apply"
command -v jq >/dev/null || fail "Install jq first"

if [[ "$MODE" == --apply ]]; then
  [[ $EUID -eq 0 ]] || fail "Run --apply with sudo"
  [[ "$(hostname)" == viking ]] || fail "This restore entrypoint requires the viking role hostname"
  [[ -f /etc/loft/dmz-ready ]] || fail "Complete the Viking restore runbook and DMZ checks first"
  for cmd in docker nft systemctl curl rsync flock; do
    command -v "$cmd" >/dev/null || fail "Missing dependency: $cmd"
  done
  systemctl is-active --quiet loft-firewall.service || fail "Loft firewall is not active"
  nft list table inet loft_host >/dev/null || fail "Host firewall table missing"
  nft list table inet loft_docker >/dev/null || fail "Docker firewall table missing"
  [[ "$(id -u littledog)" == 1003 && "$(id -g littledog)" == 1003 ]] || fail "Expected littledog UID/GID 1003"
  docker info >/dev/null || fail "Docker is unavailable"
  # Recovery must not sync content underneath a serving application. This is
  # deliberately separate from ordinary deploy-pull release promotion.
  for container in pawst mushr-tunnel; do
    running="$(docker ps --filter "name=^/${container}$" --format '{{.Names}}')"
    [[ -z "$running" ]] || fail "Stop ${container} before recovery; see the runbook"
  done
  for service in mushr pawst; do
    COMPOSE_PROFILES= docker compose \
      -f "${REPO_DIR}/services/${service}/docker-compose.yml" \
      -f "${REPO_DIR}/hosts/viking/overrides/${service}/docker-compose.override.yml" \
      config --quiet
  done
  install -d -m 0700 /var/backups/loft
  STATE_BACKUP="$(mktemp -d /var/backups/loft/pawst-restore-state.XXXXXX)"
fi

for site in hblake hsimah; do
  args=(env LOFT_FORCE_DEPLOY=1 bash "${REPO_DIR}/control-plane/pawst-deploy.sh" --no-verify "$site")
  if [[ "$MODE" == --plan ]]; then
    printf '%q ' "${args[@]}"
    printf '\n'
  else
    # Restored version markers must not skip fetching missing/corrupt content.
    # Keep previous records for recovery; failed fetches leave content untouched.
    for suffix in version sha256; do
      state="/var/lib/loft/deploy/pawst-${site}.${suffix}"
      [[ ! -e "$state" ]] || cp -p -- "$state" "${STATE_BACKUP}/"
    done
    "${args[@]}"
  fi
done

if [[ "$MODE" == --apply ]]; then
  for service in mushr pawst; do
    COMPOSE_PROFILES= docker compose \
      -f "${REPO_DIR}/services/${service}/docker-compose.yml" \
      -f "${REPO_DIR}/hosts/viking/overrides/${service}/docker-compose.override.yml" \
      up -d --wait "$service"
  done
  for domain in hbla.ke hsimah.com; do
    curl --noproxy '*' --fail --silent --show-error --max-time 10 \
      -H "Host: ${domain}" http://127.0.0.1:8080/index.html >/dev/null
  done
  code="$(curl --noproxy '*' --silent --show-error --max-time 10 -o /dev/null -w '%{http_code}' \
    -H 'Host: unknown.invalid' http://127.0.0.1:8080/)"
  [[ "$code" == 404 ]] || fail "Unexpected catch-all HTTP status: $code"
  echo "Latest content restored and local routes verified. Tunnel remains stopped."
else
  echo "Plan only. Read docs/operations/viking-restore.md before using --apply."
fi
