COMPOSE_PROFILES=client                            # "server" or "client"

# Client-only
SNAPSERVER_HOST=192.168.86.X                       # Snapserver IP address
SOUND_DEVICE=default                               # ALSA device
HOST_ID=change-me                                  # Room name for group persistence

# Fjord's Bluetooth override only; other clients ignore it.
# Plays this many ms early to cancel the speaker's internal delay. 220 lined
# Fjord's NH-69 up with Woodstock. To retune:
#   1. Set this to 0, play a click track to Upstairs and stand equidistant.
#   2. In Snapweb, raise Fjord's client latency live until the echo goes
#      (20 ms steps, then 5 ms); back off if Fjord sounds early.
#   3. Copy the value here, reset Snapweb to 0 (the two add) and
#      `loft-ctl rebuild howlr`.
SNAPCLIENT_LATENCY=220
