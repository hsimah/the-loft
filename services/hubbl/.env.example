# Hubbl — Immich photo library on space-needle
#
# Compose: services/hubbl/docker-compose.yml
# Runbook: docs/services/hubbl.md
# OneDrive migration: docs/operations/onedrive-migration.md

# Hostnames belong to Caddy, not this file: services/mushr/Caddyfile.
TZ=America/Los_Angeles

# ── Database ─────────────────────────────────────────────────────────────────
# Set BEFORE the first start. Postgres reads these only when it initialises an
# empty /opt/hubbl/db; changing DB_PASSWORD afterwards locks the server out of
# its own database, and the fix is an ALTER ROLE inside the container, not an
# edit here.
#
# Immich's upstream guidance is A-Za-z0-9 only — some of its tooling does not
# quote the password consistently:
#   openssl rand -hex 32
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ── Migration importer (cli profile only) ────────────────────────────────────
# Create in the Immich web UI under Account Settings → API Keys, paste here,
# and CLEAR IT once the OneDrive import is finished. This key is a full-account
# credential: it can read and delete every photo in the library.
#
# The cli profile is inactive by default, so leaving this blank is normal and
# does not affect the running service.
IMMICH_API_KEY=
