# Kennl — Forgejo forge and Actions runner
#
# Compose: services/kennl/docker-compose.yml
# Runbook: docs/services/kennl.md
#
# space-needle: COMPOSE_PROFILES=forge  (database settings below)
# helarctos:    COMPOSE_PROFILES=runner (RUNNER_TOKEN below)
# Compose checks every variable on both hosts, so keep all lines, even blank.
COMPOSE_PROFILES=

# Must match services/mushr/.env on space-needle; Forgejo's ROOT_URL is
# https://kennl.$LOFT_DOMAIN/ and Caddy routes the same name.
LOFT_DOMAIN=loft.hsimah.com

# ── Database ─────────────────────────────────────────────────────────────────
# Set BEFORE the first start. Postgres reads these only when it initialises an
# empty /opt/kennl/db; changing DB_PASSWORD afterwards needs an ALTER ROLE
# inside kennl-db, not an edit here.
#   openssl rand -hex 32
DB_PASSWORD=
DB_USER=forgejo
DB_NAME=forgejo

# ── Runner ───────────────────────────────────────────────────────────────────
# Site Administration → Actions → Runners → Create new runner gives a UUID and
# a token. The UUID goes in runner.yml; the token goes here.
RUNNER_TOKEN=
