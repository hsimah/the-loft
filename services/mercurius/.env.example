# Mercurius — household wiki (SilverBullet) and documents (Paperless-ngx)
#
# Compose: services/mercurius/docker-compose.yml
# Runbook: docs/services/mercurius.md
#
# SilverBullet needs nothing here: accounts are created in its setup wizard.

# Must match services/mushr/.env; PAPERLESS_URL is https://paperless.$LOFT_DOMAIN
# and Caddy routes the same name.
LOFT_DOMAIN=loft.hsimah.com
TZ=America/Los_Angeles

# Set BEFORE the first start. Postgres reads it only when it initialises an
# empty /mercurius/db; changing it afterwards needs an ALTER ROLE inside
# mercurius-db, not an edit here.
#   openssl rand -hex 32
DB_PASSWORD=

# Signs Paperless sessions and tokens. Generate once and keep it:
#   openssl rand -hex 32
PAPERLESS_SECRET_KEY=

# ── Local models ─────────────────────────────────────────────────────────────
# helarctos's llama-swap key (the same LLAMA_SWAP_API_KEY as its sputnik .env).
# Paperless's built-in AI needs it; without it AI requests fail with 401.
LLAMA_SWAP_API_KEY=

# Second-pass OCR (docs/services/mercurius.md#second-pass-ocr): set
# COMPOSE_PROFILES=ocr to run paperless-gpt. Leave it empty until you have the
# token below.
COMPOSE_PROFILES=

# A Paperless API token for paperless-gpt: Paperless's admin → Auth Tokens.
GPT_PAPERLESS_TOKEN=
