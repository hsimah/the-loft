# kennl — Forgejo. HTTP only; git SSH goes straight to space-needle:2222.
kennl.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy forgejo:3000
}

# hubbl — Immich. The public name is deliberately first-level: Cloudflare's
# free Universal SSL covers hsimah.com and *.hsimah.com but NOT a second level
# like *.loft.hsimah.com, so a loft name cannot be served through the tunnel
# without paid Advanced Certificate Manager. This is the one loft application
# on the tunnel's public hostname list, which makes Immich's own login the
# only boundary in front of the whole photo library.
#
# dnsmasq answers this name with the LAN address too, so uploads from home go
# straight here and skip the tunnel's request-body cap entirely.
#
# No request_body limit on purpose — Immich uploads originals, and a cap would
# surface as a silent mobile backup failure rather than an error. The ceiling
# for tunnelled uploads is Cloudflare's, not Caddy's; see docs/services/hubbl.md.
hubbl.hsimah.com {
	import cloudflare_tls
	reverse_proxy hubbl:2283
}

# LAN browser access over the loft name; never reachable from outside.
hubbl.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy hubbl:2283
}

# sputnik — Open WebUI chat surface. Note there is deliberately NO route for
# llama-swap: it lives on helarctos and stays LAN-only.
sputnik.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy open-webui:8080
}

# mercurius — household wiki (SilverBullet). HTTPS only: its offline PWA needs
# a secure origin, and each space is bound to this hostname. Never on the tunnel.
mercurius.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy mercurius:3000
}

# plutus — household vault (Paperless-ngx). Reached over the internal
# plutus-proxy network (space-needle mushr override). Never on the tunnel.
plutus.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy plutus:8000
}

n8n.{$LOFT_DOMAIN} {
	import cloudflare_tls
	reverse_proxy n8n:5678
}

{$LOFT_DOMAIN} {
	import cloudflare_tls
	redir https://homepage.{$LOFT_DOMAIN}{uri}
}

