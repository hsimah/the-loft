# Plutus — household vault (Paperless-ngx)
#
# Compose: services/plutus/docker-compose.yml
# Runbook: docs/services/plutus.md

# Must match services/mushr/.env; PAPERLESS_URL is https://plutus.$LOFT_DOMAIN
# and Caddy routes the same name.
LOFT_DOMAIN=loft.hsimah.com
TZ=America/Los_Angeles

# Set BEFORE the first start. Postgres reads it only when it initialises an
# empty /plutus/db; changing it afterwards needs an ALTER ROLE inside
# plutus-db, not an edit here.
#   openssl rand -hex 32
DB_PASSWORD=

# Signs sessions and tokens. Generate once and keep it:
#   openssl rand -hex 32
PAPERLESS_SECRET_KEY=
