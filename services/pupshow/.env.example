# Pupshow — Immich Kiosk photo frame (Lady Grey)
#
# Compose: services/pupshow/docker-compose.yml
# Runbook: docs/hosts/lady-grey.md#photo-frame

KIOSK_IMMICH_URL=https://hubbl.loft.hsimah.com
# Key from a dedicated, non-admin Immich user that can see only the frame's
# album (Account Settings → API Keys). Never an admin key.
KIOSK_IMMICH_API_KEY=
# Album IDs, comma-separated: the UUID in the album's URL.
KIOSK_ALBUMS=
