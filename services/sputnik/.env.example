# Sputnik — local LLM engine + assistant surfaces
#
# Compose profiles control which containers run:
#   engine — ollama (inference server; no auth, loopback + bridge only)
#   chat   — open-webui (conversational UI at https://sputnik.$LOFT_DOMAIN)
#   agent  — n8n (scheduled workflows at https://n8n.$LOFT_DOMAIN)
#
# space-needle (the only host with the RAM and cores for this):
#   COMPOSE_PROFILES=engine,chat,agent
#
# Nothing else in the fleet is configured to run sputnik.

COMPOSE_PROFILES=engine,chat,agent

# ── Shared ───────────────────────────────────────────────────────────────────
# Must match services/mushr/.env — compose interpolates it into the n8n and
# open-webui hostnames, and Caddy routes on the same value.
LOFT_DOMAIN=loft.hsimah.com
TZ=America/Los_Angeles

# ── Ollama ───────────────────────────────────────────────────────────────────
# Context window in tokens; verify actual prompt size and RAM headroom.
# Keep the derived model settings consistent when changing this value.
OLLAMA_CONTEXT_LENGTH=16384

# ── Open WebUI ───────────────────────────────────────────────────────────────
# Signing key for session cookies. Generate once and keep it — rotating it logs
# every user out:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# Leave true to create the first (admin) account, then set to false and
# `loft-ctl rebuild sputnik` so the login page stops offering signup.
ENABLE_SIGNUP=true

# ── n8n ──────────────────────────────────────────────────────────────────────
# Encrypts every stored credential, including the Google OAuth refresh token.
# Generate once:
#   openssl rand -hex 32
#
# BACK THIS UP. Losing it means every saved credential in /opt/sputnik/n8n is
# unrecoverable and every Google connection must be re-authorised from scratch.
N8N_ENCRYPTION_KEY=

# Google OAuth credentials are entered in n8n, not this file.
# Read-only scopes, callback and setup: docs/services/sputnik.md#google-oauth
# Import/validation: services/sputnik/workflows/briefing.md
