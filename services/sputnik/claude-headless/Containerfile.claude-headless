FROM docker.io/library/node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=latest

RUN apt-get update \
 && apt-get install --yes --no-install-recommends git ripgrep jq ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

COPY --chmod=0755 run-claude-in-container /usr/local/bin/run-claude-in-container

ENV HOME=/claude-home \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/run-claude-in-container"]
