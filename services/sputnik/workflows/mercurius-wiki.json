      "name": "MCP Server Trigger",
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Open WebUI MCP"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "List every file in the household wiki. Pages end in .md; folders are path prefixes, e.g. Travel/Canada/Quebec/Montreal.md. Use it to find existing pages and follow the layout already in use.",
        "url": "https://wiki.loft.hsimah.com/home/.fs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sync-Mode",
              "value": "true"
            }
          ]
        },
        "options": {},
        "optimizeResponse": true,
        "responseType": "json",
        "fieldsToInclude": "selected",
        "fields": "name"
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [
        0,
        220
      ],
      "name": "list_pages",
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "SilverBullet sputnik"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Read one wiki page as markdown by its path, e.g. Travel.md or Travel/Canada/Quebec/Montreal.md. Read an area page (Travel.md) for its Conventions section before writing under it.",
        "url": "=https://wiki.loft.hsimah.com/home/.fs/{{ $fromAI('path', 'page path ending in .md', 'string') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sync-Mode",
              "value": "true"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.5,
      "position": [
        200,
        220
      ],
      "name": "read_page",
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "SilverBullet sputnik"
        }
      }
    },
    {
      "parameters": {
        "description": "Create a new wiki page. Fails if the page exists. text is the whole page in plain markdown, starting with a # title.",
        "workflowId": {
