NORDVPN_TOKEN=your-nordvpn-token-here

# Service account UID/GID (littledog:pack-member)
# Audiobookshelf uses these IDs directly; match the host's directory ownership.
PUID=1003
PGID=1003
TZ=America/Los_Angeles

# Soulseek (slskd)
SLSKD_SOULSEEK_USERNAME=your-soulseek-username
SLSKD_SOULSEEK_PASSWORD=your-soulseek-password
